# Copiar como .env y rellenar. El .env no se sube al repositorio.

# Contrasena del usuario de la base dentro del contenedor de Postgres.
POSTGRES_PASSWORD=pon-una-contrasena-larga-aqui

# Firma de los tokens de sesion. Minimo 64 caracteres.
# Generar una al azar:  openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=pon-aqui-un-secreto-de-al-menos-64-caracteres-generado-al-azar

# Puerto por el que se publica la aplicacion en la maquina anfitriona.
# En local 8090 evita chocar con el backend que corras desde el IDE en 8080.
# En el servidor se pone 80.
HTTP_PORT=8090

# Opcionales: solo si se quiere cambiar el nombre de la base o del usuario.
# POSTGRES_DB=lacasadelchef
# POSTGRES_USER=chfadmin

# Memoria de la JVM. En desarrollo se puede dejar vacio (toma el 70% de la RAM
# visible). En un Lightsail de 2 GB, donde Postgres y nginx comparten la
# maquina, conviene acotarla:
#   JAVA_OPTS=-Xmx640m -XX:MaxMetaspaceSize=192m
# En uno de 1 GB:
#   JAVA_OPTS=-Xmx384m -XX:MaxMetaspaceSize=160m

# --- Solo para produccion (docker-compose.prod.yml) ---------------------
# Dominio que atiende Caddy y correo para los avisos de Let's Encrypt.
# DOMAIN=erp.midominio.com
# ACME_EMAIL=tucorreo@ejemplo.com
#
# En el servidor, nginx no se publica a internet: solo Caddy lo alcanza.
# HTTP_PORT=127.0.0.1:8090
